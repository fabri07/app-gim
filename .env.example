# Copiar a .env y completar. En producción (Render) estas variables se
# configuran directamente en la plataforma vía render.yaml/dashboard, no vía
# archivo -- este .env es solo para desarrollo local.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Fase 5 (producción, ver render.yaml y CLAUDE.md):
#
# DATABASE_URL: si no está seteada, se usa SQLite local (comportamiento
#   actual). En Render la inyecta automáticamente el Blueprint.
# DJANGO_CSRF_TRUSTED_ORIGINS: esquema+host completo, CSV. Ej:
#   https://app-gim-xxxx.onrender.com
# R2_*: credenciales del bucket de Cloudflare R2 (comprobantes, logos). Sin
#   estas 4 variables, Django usa el filesystem local (FileSystemStorage) --
#   nunca dejar esto así en producción, el filesystem de Render es efímero.
#
# DATABASE_URL=
# DJANGO_CSRF_TRUSTED_ORIGINS=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT_URL=

# Parte C (integración Google Calendar del alumno, OAuth por usuario). Sin
# estas 4 variables la integración queda apagada y el portal muestra solo el
# deep-link "Agregar a Google Calendar". Se crean en Google Cloud Console
# (OAuth Client tipo Web, consent screen en modo Testing) -- ver CLAUDE.md.
# GOOGLE_TOKEN_ENCRYPTION_KEY: clave Fernet, generarla con
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# GOOGLE_TOKEN_ENCRYPTION_KEY=
