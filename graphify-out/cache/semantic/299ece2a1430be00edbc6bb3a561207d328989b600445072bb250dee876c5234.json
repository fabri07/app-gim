 the tenant automatically: that would be implicit and couple the model layer to the request cycle. While the product is simple (YAGNI), an explicit `for_gimnasio()` method is clearer and more testable. The view-layer TenantScopedMixin applies it once so no developer can forget it per-view."}, {"id": "core_models_tenantownedmodel", "label": "TenantOwnedModel", "file_type": "code", "source_file": "core/models.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_models_tenantqueryset", "label": "TenantQuerySet", "file_type": "code", "source_file": "core/models.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_models_tenantownedmodel", "label": "TenantOwnedModel", "file_type": "code", "source_file": "core/models.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_models_timestampedmodel", "label": "TimeStampedModel", "file_type": "code", "source_file": "core/models.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_models_tenantownedmodel", "label": "TenantOwnedModel", "file_type": "code", "source_file": "core/models.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "core_models_tenantownedmodel", "target": "core_models_timestampedmodel", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "core/models.py", "source_location": "43", "weight": 1.0}, {"source": "core_models_tenantownedmodel", "target": "core_models_tenantqueryset", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "core/models.py", "source_location": "63", "weight": 1.0}, {"source": "core_models_tenantownedmodel", "target": "tenants_models_gimnasio", "relation": "reference