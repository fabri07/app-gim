{"nodes": [{"id": "app_gim_roadmap", "label": "ROADMAP.md (plan v2, fases 0-9)", "file_type": "document", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_fase_0", "label": "Fase 0 \u2014 Extracci\u00f3n del esqueleto reutilizable", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_fase_1", "label": "Fase 1 \u2014 Modelo de datos m\u00ednimo", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_fase_2", "label": "Fase 2 \u2014 Backend funcional (flujos del staff)", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_fase_3", "label": "Fase 3 \u2014 Portal del alumno", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_fase_4", "label": "Fase 4 \u2014 UX/UI y white-label", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_fase_5", "label": "Fase 5 \u2014 Deploy en Render", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_fase_6", "label": "Fase 6 \u2014 Primer piloto pago (onboarding concierge)", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_fase_9", "label": "Fase 9 \u2014 Features posteriores (solo con clientes pagos)", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_snapshot_rutina", "label": "Patr\u00f3n snapshot de rutina asignada", "file_type": "rationale", "rationale": "Al asignar una rutina se copia (congela) la info de la plantilla: editar la plantilla despu\u00e9s NO cambia el historial del alumno. Modelo clave del dominio.", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_pagos_autogenerados_cron", "label": "Pagos autogenerados por cron (el due\u00f1o confirma, no crea)", "file_type": "rationale", "rationale": "Los pendientes del mes se autogeneran por cron y pasan pendiente\u2192vencido solos; sin esto el dato se pudre. Sin Mercado Pago ni integraci\u00f3n financiera en el MVP.", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_object_storage_r2", "label": "Media en Cloudflare R2, nunca en el filesystem de Render", "file_type": "rationale", "rationale": "El filesystem de Render es ef\u00edmero (se borra en cada deploy); comprobantes y logos van a R2 (S3-compatible, free tier generoso, sin costo de egress) v\u00eda django-storages. Se decide antes de subir el primer comprobante real.", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_tenant_sin_subdominios", "label": "Tenant resuelto por usuario logueado, sin subdominios", "file_type": "rationale", "rationale": "Evitar DNS wildcard + SSL por subdominio en el MVP; el gimnasio se identifica por el usuario logueado (o path /g/slug/). Subdominios quedan para Fase 9.", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_acceso_alumno_staff_password", "label": "Acceso del alumno: usuario/contrase\u00f1a asignados por el staff (no magic-link)", "file_type": "rationale", "rationale": "Decisi\u00f3n del due\u00f1o del producto (2026-07-01). El riesgo de 'call center de reseteos' que motivaba el magic-link no aplica: el reseteo tambi\u00e9n lo hace el staff a mano, cara a cara o por WhatsApp \u2014 gimnasios chicos, trato directo. fecha_activacion se registra en el primer login (mide adopci\u00f3n real).", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_rol_staff_unico", "label": "Roles due\u00f1o y entrenador colapsados en un rol staff", "file_type": "rationale", "rationale": "En gimnasios chicos suelen ser la misma persona; menos roles = menos l\u00f3gica de permisos. Separarlos queda para despu\u00e9s.", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_primero_se_cobra", "label": "Principio: primero se cobra, despu\u00e9s se sofistica", "file_type": "rationale", "rationale": "No construir nada que no ayude directamente a conseguir o retener los primeros tres gimnasios pagos. Excluye QR, asistencia, app nativa, Mercado Pago, chat, nutrici\u00f3n, IA de rutinas, subdominios.", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_gim_roadmap_white_label", "label": "Personalizaci\u00f3n white-label por gimnasio (logo, colores, textos)", "file_type": "concept", "rationale": "Todo sale de los campos del modelo Gimnasio, un solo c\u00f3digo: nombre visible, logo, colores, bienvenida, contacto, redes.", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "app_gim_roadmap", "target": "app_gim_issues", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "app_gim_roadmap", "target": "app_gim_roadmap_fase_0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "app_gim_roadmap", "target": "app_gim_roadmap_fase_1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "app_gim_roadmap", "target": "app_gim_roadmap_fase_2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "app_gim_roadmap", "target": "app_gim_roadmap_fase_3", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "app_gim_roadmap", "target": "app_gim_roadmap_fase_4", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "app_gim_roadmap", "target": "app_gim_roadmap_fase_5", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "app_gim_roadmap", "target": "app_gim_roadmap_fase_6", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "app_gim_roadmap", "target": "app_gim_roadmap_fase_9", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "app_gi