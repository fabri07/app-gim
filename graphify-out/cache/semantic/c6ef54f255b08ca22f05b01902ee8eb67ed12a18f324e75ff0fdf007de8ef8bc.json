{"nodes": [{"id": "tenants_models_perfil", "label": "Perfil", "file_type": "code", "source_file": "tenants/models.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tenants_models_gimnasio", "label": "Gimnasio", "file_type": "code", "source_file": "tenants/models.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tenants_models_gimnasio", "label": "Gimnasio (tenant)", "file_type": "code", "source_file": "tenants/models.py", "source_location": "19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tenants_models_perfil", "label": "Perfil (User-Gimnasio link + rol)", "file_type": "code", "source_file": "tenants/models.py", "source_location": "56", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_composition_over_inheritance_auth", "label": "Perfil: composition over inheritance for auth User", "file_type": "rationale", "source_file": "tenants/models.py", "source_location": "56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Perfil links Django's auth User to its Gimnasio and rol via OneToOne instead of extending/replacing User (composition over inheritance, keeps auth model clean). Uses settings.AUTH_USER_MODEL (not hardcoded auth.User) to allow a future custom User without rewriting FKs. on_delete CASCADE from User (a profile without its user is meaningless) but PROTECT toward Gimnasio (no accidental deletion of a gym with live users). MVP roles: staff (owner and/or trainer, same permissions) and alumno."}, {"id": "concept_white_label_customization", "label": "White-label per-gym customization", "file_type": "rationale", "source_file": "tenants/models.py", "source_location": "19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gimnasio carries logo, color_primario/secundario, texto_bienvenida, contacto and social links (added in migration 0002). GimnasioUpdateView has no pk in the URL on purpose \u2014 it always edits the logged-in Perfil's own gym, so TenantScopedMixin is unnecessary (no other gym reachable). GimnasioForm excludes slug/activo: platform-management fields, editable only in /admin/. Logo uploads go to MEDIA storage that Fase 5 switches to Cloudflare R2 without touching the field (Render's filesystem is ephemeral)."}, {"id": "tenants_models_gimnasio", "label": "Gimnasio", "file_type": "code", "source_file": "tenants/models.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tenants_models_perfil", "label": "Perfil", "file_type": "code", "source_file": "tenants/models.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tenants_models_gimnasio", "label": "Gimnasio (tenant)", "file_type": "code", "source_file": "tenants/models.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tenants_models_perfil", "label": "Perfil (User\u2194Gimnasio + rol staff/alumno)", "file_type": "code", "source_file": "tenants/models.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "tenants_models_gimnasio", "target": "core_models_timestampedmodel", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tenants/models.py", "source_location": "19", "weight": 1.0}, {"source": "tenants_models_perfil", "target": "core_models_timestampedmodel", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tenants/models.py", "source_location": "56", "weight": 1.0}, {"source": "tenants_models_perfil", "target": "tenants_models_gimnasio", "relation": "references", "confidence": "EXTRACTED", "confidence_sco