{"nodes": [{"id": "core_forms_tenantscopedmodelform", "label": "TenantScopedModelForm", "file_type": "code", "source_file": "core/forms.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_forms_tenantscopedmodelform", "label": "TenantScopedModelForm", "file_type": "code", "source_file": "core/forms.py", "source_location": "19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_fk_injection_prevention", "label": "FK-injection prevention via tenant-scoped form querysets", "file_type": "rationale", "source_file": "core/forms.py", "source_location": "19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stamping `gimnasio` on the new object is not enough: a form with an FK to another tenant-owned entity (e.g. RutinaAsignada.alumno, PagoMensual.alumno) would let a POST submit the id of a record from another gym. TenantScopedModelForm automatically narrows the queryset of every tenant-owned ModelChoiceField to the received gimnasio \u2014 written once, impossible to forget (DRY)."}, {"id": "core_forms_tenantscopedmodelform", "label": "TenantScopedModelForm", "file_type": "code", "source_file": "core/forms.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_forms_tenantscopedmodelform", "label": "TenantScopedModelForm", "file_type": "code", "source_file": "core/forms.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_forms_tenantscopedmodelform", "label": "TenantScopedModelForm (anti FK-injection)", "file_type": "code", "source_file": "core/forms.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "core_forms_tenantscopedmodelform", "target": "core_models_tenantownedmodel", "relation": "references", "c