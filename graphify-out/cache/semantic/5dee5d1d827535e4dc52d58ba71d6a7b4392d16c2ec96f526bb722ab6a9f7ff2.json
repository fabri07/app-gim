stado/alumno/mes/anio. La autogeneracion vive como funciones de modulo, no en una capa de servicios (proyecto chico, KISS). Es el comando que Fase 5 programa como Render Cron Job."}, {"id": "pagos_models_pagomensual", "label": "PagoMensual", "file_type": "code", "source_file": "pagos/models.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pagos_models_generar_pagos_pendientes", "label": "generar_pagos_pendientes / marcar_vencidos", "file_type": "code", "source_file": "pagos/models.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "pagos_models_generar_pagos_pendientes", "target": "pagos_models_pagomensual", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pagos/models.py", "source_location": "L96", "weight": 1.0}, {"source": "pagos_models_generar_pagos_pendientes", "target": "alumnos_models_alumno", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pagos/models.py", "source_location": "L87-L94", "weight": 1.0}, {"source": "pagos_models_marcar_vencidos", "target": "pagos_models_pagomensual", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pagos/models.py", "source_location": "L115", "weight": 1.0}, {"source": "pagos_models_pagomensual", "target": "core_models_tenantownedmodel", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pagos/models.py", "source_location": "L25", "weight": 1.0}, {"source": "pagos_models_pagomensual", "target": "alumnos_models_alumno", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pagos/models.py", "source_location": "L44-L48", "weight": 1.0}, {"source": "pagos_models_autogeneracion_por_cron", "target": "pagos_models_generar_pagos_pendientes", "relation": "rationa